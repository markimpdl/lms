# Pasta de exemplos copiados de outros projetos — NUNCA versionar
examples/

# Configs locais com segredos
.env
.env.*
!.env.example
!scripts/deploy/.env.deploy.example
config/env.php
.mcp.json
.claude/settings.local.json

# Uploads de produção (alunos enviam arquivos lá) — pasta criada pelo installer
storage/uploads/
public/uploads/
uploads/

# Logs de runtime — versionar só .gitkeep e .htaccess
storage/logs/*
!storage/logs/.gitkeep
!storage/logs/.htaccess

# Cache em arquivo — versionar só .gitkeep e .htaccess
storage/cache/*
!storage/cache/.gitkeep
!storage/cache/.htaccess

# Dependências
/vendor/
/node_modules/

# Estado local de scripts (ex.: deploy incremental)
scripts/deploy/.ftp-state.json

# Logs e temporários
*.log
*.tmp
*.cache
.DS_Store
Thumbs.db

# IDE
/.idea/
/.vscode/
*.swp

# Composer
composer.phar

# Build outputs
/dist/
/build/
