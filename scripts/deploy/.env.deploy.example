# Credenciais FTPS para deploy — copie para .env.deploy (gitignored) na raiz do repo
# e preencha. O deploy lê este arquivo em cada execução.

# Servidor FTP/FTPS
FTP_HOST=
FTP_PORT=21
FTP_USER=
FTP_PASSWORD=

# Segurança
# FTP_SECURE=true  -> FTPS explícito (AUTH TLS sobre porta 21)
# FTP_SECURE=false -> FTP simples (nunca use em produção)
FTP_SECURE=true

# FTP_ALLOW_SELF_SIGNED=true em caso de certificado self-signed no servidor
# (Hostinger compartilhado às vezes usa)
FTP_ALLOW_SELF_SIGNED=true

# Raiz remota onde o deploy vai publicar.
# - Hostinger (hPanel) com FTP account específico do domínio: geralmente já cai
#   dentro do document root -> FTP_REMOTE_ROOT=/
# - cPanel tradicional (FTP cai em /home/user/): FTP_REMOTE_ROOT=/public_html
# Liste a raiz do FTP com um cliente (FileZilla, WinSCP) pra ter certeza.
FTP_REMOTE_ROOT=/
