# Credenciais FTPS para deploy — copie para .env.deploy (gitignored) na raiz do repo
# e preencha. O deploy lê este arquivo em cada execução.

# Servidor FTP/FTPS
FTP_HOST=
FTP_PORT=21
FTP_USER=
FTP_PASSWORD=

# Segurança
# FTP_SECURE=true  -> FTPS explícito (AUTH TLS sobre porta 21)
# FTP_SECURE=false -> FTP simples (nunca use em produção)
FTP_SECURE=true

# FTP_ALLOW_SELF_SIGNED=true em caso de certificado self-signed no servidor
# (Hostinger compartilhado às vezes usa)
FTP_ALLOW_SELF_SIGNED=true

# Raiz remota do document root. Em cPanel tradicional é /public_html.
FTP_REMOTE_ROOT=/public_html
